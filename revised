        <p>Talk to your healthcare provider about your individual situation.</p>
    </div>
</div>

<script>
    // Progress bar
    function updateProgress() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = (scrollTop / docHeight) * 100;
        document.getElementById('progressFill').style.width = scrollPercent + '%';
    }
    window.addEventListener('scroll', updateProgress);

    // Quiz
    function checkAnswer(element, isCorrect) {
        const container = element.parentElement;
        const options = container.querySelectorAll('.quiz-option');
        
        options.forEach(opt => {
            opt.onclick = null;
            opt.style.cursor = 'default';
        });

        setTimeout(() => {
            let feedback = document.createElement('div');
            feedback.className = 'quiz-feedback ' + (isCorrect ? 'correct' : 'incorrect');
            
            if (isCorrect) {
                feedback.innerHTML = '✅ Correct! Your brain develops throughout your teens and into your mid-20s.';
                element.classList.add('correct');
            } else {
                feedback.innerHTML = '❌ Not quite. Your brain doesn\'t finish developing until your mid-20s!';
                element.classList.add('incorrect');
            }
            
            container.appendChild(feedback);
        }, 300);
    }

    // Cards
    function toggleCard(element) {
        element.style.transform = element.style.transform === 'scale(1.05)' ? 'scale(1)' : 'scale(1.05)';
    }

    // Expandable
    function toggleExpandable(header) {
        const content = header.nextElementSibling;
        const arrow = header.querySelector('.toggle-arrow');
        
        content.classList.toggle('open');
        arrow.classList.toggle('open');
    }

    // Tabs
    function switchTab(e, tabName) {
        e.preventDefault();
        
        document.querySelectorAll('.tab-content').forEach(tab => {
            tab.classList.remove('active');
        });
        
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('active');
        });
        
        document.getElementById(tabName).classList.add('active');
        e.target.classList.add('active');
    }

    // Scenarios
    function showScenarioResult(button, type) {
        const container = button.parentElement;
        
        const existing = container.querySelector('.scenario-result');
        if (existing) existing.remove();
        
        let result = document.createElement('div');
        result.className = 'scenario-result result-' + type;
        
        if (type === 'good') {
            result.innerHTML = '✅ <strong>Great choice!</strong> You\'re protecting your health. That takes strength.';
        } else if (type === 'caution') {
            result.innerHTML = '⚠️ <strong>Risky move.</strong> Have an exit plan.';
        } else {
            result.innerHTML = '❌ <strong>Heads up:</strong> This puts your health and future at risk.';
        }
        
        container.appendChild(result);
    }
</script>

